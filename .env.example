# Variables exclusivas del servidor. No usar prefijos VITE_ para secretos.
# Copiá este archivo a .env.local y completá los valores ahí.
# Si OPENAI_API_KEY u OPENAI_MODEL están vacíos, Cope AI arranca en modo demo.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Opcionales
# OPENAI_TOKEN_PARAM=max_tokens
# OPENAI_JSON_MODE=1
# OPENAI_VISION=0
# COPE_DEMO=1
# COPE_DEMO_DELAY_MS=15
# COPE_RATE_LIMIT_PER_MINUTE=10
# COPE_QUIZ_RATE_LIMIT_PER_MINUTE=5
# COPE_STUDY_RATE_LIMIT_PER_MINUTE=5
