# Variables exclusivas del servidor. No usar prefijos VITE_ para secretos.
# Copiá este archivo a .env.local y completá los valores ahí.
# Si OPENAI_API_KEY u OPENAI_MODEL están vacíos, Cope AI arranca en modo demo.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Opcionales
# OPENAI_TOKEN_PARAM=max_tokens
# OPENAI_JSON_MODE=1
# OPENAI_VISION=0
# COPE_DEMO=1
# COPE_DEMO_DELAY_MS=15
# COPE_RATE_LIMIT_PER_MINUTE=10
# COPE_QUIZ_RATE_LIMIT_PER_MINUTE=5
# COPE_STUDY_RATE_LIMIT_PER_MINUTE=5
# COPE_ORAL_RATE_LIMIT_PER_MINUTE=3
# COPE_ORAL_REPLY_RATE_LIMIT_PER_MINUTE=20
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# COPE_VOICE_CLONE=0
# COPE_VOICE_CLONE_CODE=
# COPE_TTS_RATE_LIMIT_PER_MINUTE=10
# COPE_VOICE_CLONE_RATE_LIMIT_PER_MINUTE=2

# Motor de IA: auto, openai, ollama o pollinations.
# Sin configuración usa la nube gratuita sin clave (límite aproximado 1/30 s).
# COPE_AI_PROVIDER=auto
# POLLINATIONS_MODEL=openai
# POLLINATIONS_API_KEY=
# COPE_LOCAL_AI=1
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:3b-cpu
# OLLAMA_VISION=0
